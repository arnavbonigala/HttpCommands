{
	"schemaVersion": 1,
	"id": "httpcommands",
	"version": "${version}",
	"name": "HttpCommands",
	"description": "Adds /httpget and /httppost commands for making HTTP requests in singleplayer. Supports command blocks, rate limiting, and configurable safety controls.",
	"authors": [
		"arnavbonigala"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/httpcommands/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.arnavbonigala.Httpcommands"
		],
		"client": [
			"com.arnavbonigala.HttpcommandsClient"
		]
	},
	"mixins": [
		"httpcommands.mixins.json",
		{
			"config": "httpcommands.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}